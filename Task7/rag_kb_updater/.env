# --- Paths ---
KB_ROOT=../knowledge_base
MANIFEST_PATH=./_artifacts/manifest.json
RUNS_DIR=./_runs

OUT_DIR=./_artifacts/prepared_chunks

# --- Chroma ---
# для локального запуска- только для подсчета размера индекса chroma, для docker - через environment в docker-compose
CHROMA_DB_DIR=../chroma_db
CHROMA_COLLECTION=BAAI--bge-m3_1024_130

# http/persistent
CHROMA_MODE=persistent
CHROMA_HOST=chroma
CHROMA_PORT=8000


#  ---- SentenceTransformer model ----
EMBEDDER_MODEL=BAAI/bge-m3

# --- Chunks file path ---
CHUNKS_PATH=./_artifacts/prepared_chunks/BAAI--bge-m3_1024_130.jsonl

# --- Tokenizer config ---
MAX_TOKENS=1024
OVERLAP_TOKENS=130

# --- Scheduler (APScheduler) ---
SCHED_ENABLED=true
SCHED_CRON=*/1 * * * *
SCHED_RUN_ON_START=false

# --- Update strategy ---
UPDATE_STRATEGY=replace_file

RAG_API_SAFE_URL=http://localhost:8002
GOLDEN_QUESTIONS_PATH=./_golden/golden_questions.jsonl
RETRIEVAL_LOGS_DIR=./_runs/retrieval_logs
GOLDEN_TOP_K=5