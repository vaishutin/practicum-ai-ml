# Не содержит секретов.

# Модель LLM
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2

# Chroma
# для локального запуска, /app/chroma_dbпереписано в docker-compose
CHROMA_DB_PATH=../chroma_db
CHROMA_COLLECTION_NAME=BAAI--bge-m3_1024_130

# http/persistent, # для локального запуска, http переопределено в docker-compose
CHROMA_MODE=persistent
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RAG_TOP_K=5
PORT=8002