# где лежит _runs от rag-kb-updater
KB_RUNS_DIR=../rag_kb_updater/_runs

# наши папки
GOLDEN_DIR=./_golden
METRICS_DIR=./_metrics
RUNS_DIR=./_runs

# rag-api-safe
RAG_API_BASE_URL=http://localhost:8002
MODE=few_shot
SAFE_PROMPT=true
RAG_API_TIMEOUT_S=120

# scheduler
CRON=*/1 * * * *
#CRON=*/5 * * * *
RUN_ON_START=false

# ragas
RAGAS_JUDGE_MODEL=gpt-4o-mini
RAGAS_EMB_MODEL=text-embedding-3-small
RAGAS_CONCURRENCY=8